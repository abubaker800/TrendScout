# Copy to .env and fill in. Never commit .env.
PORT=3001
# Public base URL of THIS server (must match the redirect URL registered in your Shopify app)
PUBLIC_URL=http://localhost:3001
NODE_ENV=development

# chrome://extensions → copy the extension ID (comma-separate several). Required in production.
ALLOWED_EXTENSION_IDS=

# 64 hex chars (32 bytes) used to encrypt store tokens at rest:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# Shopify app (Partner dashboard → Apps → your app)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products

# Data providers (all optional)
SERPAPI_KEY=        # Google Trends via SerpApi
RAINFOREST_KEY=     # Amazon Best Sellers via Rainforest API
META_ACCESS_TOKEN=  # Meta Ad Library API
